{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DIU Routine JSON v1",
  "description": "Canonical interchange format for DIU CSE Routines",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "diu-routine-v1"
    },
    "semester": {
      "type": ["string", "null"]
    },
    "department": {
      "type": ["string", "null"]
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_code": {
            "type": "string",
            "minLength": 1
          },
          "group_code": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": ["string", "null"]
          },
          "section": {
            "type": ["string", "null"]
          },
          "subgroup": {
            "type": ["string", "null"]
          },
          "special_group": {
            "type": ["string", "null"]
          },
          "teacher": {
            "type": ["string", "null"]
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "day": {
            "type": "string",
            "enum": ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
          },
          "start_time": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end_time": {
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "required": [
          "course_code",
          "group_code",
          "room",
          "day",
          "start_time",
          "end_time"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "semester",
    "department",
    "classes"
  ],
  "additionalProperties": false
}
